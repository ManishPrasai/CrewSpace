# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only, never expose

# Stripe (test mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="Crewspace <noreply@yourdomain.com>"

# Push notifications (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# OAuth (ADR-026) - comma-separated list of providers to show on
# /login and /signup, e.g. "google,azure,apple". Leave unset/empty to
# keep every provider button hidden (default - no provider works until
# you've also set enabled=true + real client_id/secret for it in
# supabase/config.toml; the secrets those reference go in
# supabase/.env, not here - see supabase/.env.example).
NEXT_PUBLIC_AUTH_PROVIDERS=
