# Read by the Supabase CLI itself (supabase start / db reset / test db),
# not by Next.js - this is a separate file from the project root's
# .env.local on purpose. Copy to supabase/.env (gitignored) and fill in
# real values once you have Google Cloud / Microsoft Entra OAuth app
# credentials (ADR-026). Leave blank and the corresponding provider in
# supabase/config.toml stays enabled=false regardless of what
# NEXT_PUBLIC_AUTH_PROVIDERS says.
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_AZURE_SECRET=
